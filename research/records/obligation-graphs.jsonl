{"attempt_id": "attempt:web-20260906-opg37357-a01", "created_at": "2026-09-06T05:03:30Z", "graph_id": "graph:opg37357-initial-v1", "obligations": [{"acceptance": {"allowed_candidate_kinds": ["proof", "counterexample", "formalization", "computation"], "required_capabilities": ["kernel_check", "axiom_escape_audit", "statement_faithfulness"]}, "dependencies": ["obligation:opg37357-bounded-polygon-encoding"], "kind": "root_claim", "obligation_id": "obligation:opg37357-root", "source_refs": ["problem-library/records/canonical-problems.jsonl"], "statement": {"formal_declaration": null, "language": "en", "text": "Does there exist a finite planar graph with obstacle number greater than 1? Separately, does there exist a universal integer k such that every finite planar graph has obstacle number at most k?"}, "statement_sha256": "2b45bf24bd64b1e08bb5320c90396ff6d67b834db0c3bc8d39fd09e777e13128"}, {"acceptance": {"allowed_candidate_kinds": ["proof", "counterexample", "formalization", "computation"], "required_capabilities": ["kernel_check", "axiom_escape_audit", "statement_faithfulness"]}, "dependencies": [], "kind": "lemma", "obligation_id": "obligation:opg37357-bounded-polygon-encoding", "source_refs": ["problem-library/records/canonical-problems.jsonl", "research/records/failed-routes.jsonl"], "statement": {"formal_declaration": null, "language": "zh", "text": "对固定 labeled planar graph G 和整数 m，构造并审计一个 existential-real/semialgebraic 候选编码，使其精确表达“G 存在一般位置直线可见性表示及一个至多 m 个顶点的 simple polygon obstacle”；证明编码的 soundness，并明确 unrestricted obstacle number 1 的 completeness 尚缺什么。"}, "statement_sha256": "68308f97652b9b505f308f82eb5141a1ccfa50d25dd9a71f5332476348fcafd1"}], "problem_contract_sha256": "10fb03f159d4818c5141567a77390e1351fda77c9810ac45d66dd7d4e14aa4f5", "problem_id": "problem:opg-37357-obstacle-number", "root_obligation_id": "obligation:opg37357-root", "route_id": "route:one-obstacle-semialgebraic-encoding-v1", "schema_version": "1.0.0", "supersedes": null}
